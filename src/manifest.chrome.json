{
  "manifest_version": 3,
  "name": "DoomName — Surveillance de domaines",
  "short_name": "DoomName",
  "version": "1.0.0",
  "description": "Vérifiez la disponibilité d'un nom de domaine et surveillez-le en un clic, depuis n'importe quel onglet.",
  "homepage_url": "https://www.doomname.com",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "DoomName",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "contextMenus", "notifications", "alarms"],
  "host_permissions": ["https://www.doomname.com/*"],
  "commands": {
    "watch-current-domain": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Surveiller le domaine de l'onglet actif"
    }
  }
}
